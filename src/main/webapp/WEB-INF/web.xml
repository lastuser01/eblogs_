<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- Servlet Mappings -->
    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>com.user.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/UserServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BlogEditServlet</servlet-name>
        <servlet-class>com.user.BlogEditServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BlogEditServlet</servlet-name>
        <url-pattern>/BlogEditServlet</url-pattern>
    </servlet-mapping>
</web-app>
